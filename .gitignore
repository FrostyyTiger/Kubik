# --- Godot 4 ---
# Derived import/shader/UID cache. Regenerated on open, never commit it.
.godot/

# Android build template, if we ever export to mobile.
/android/

# export_presets.cfg is deliberately NOT ignored. CI has no editor and cannot
# invent an export configuration, so the preset must travel with the repo.
# That is safe only while codesign/enable stays false - signing credentials
# belong in GitHub Actions secrets, never in a committed file.

# Local export output.
build/

# Scratch images dropped in the project root. Godot imports anything under the
# project directory and writes a committed-by-policy .import sidecar next to it,
# so a stray debug PNG here does not stay stray - it becomes two tracked files.
# distance v2 shipped two of them to main this way, from an agent that wrote its
# working crops beside the project instead of into a scratch directory.
/*.png
/*.png.import

# Generated from CSV translation files.
*.translation

# NOTE: *.import files next to assets ARE committed on purpose. They record
# import settings (e.g. nearest-neighbour filtering on our block texture).
# Ignoring them makes assets re-import with defaults on someone else's machine.

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Claude Code worktrees and session files
.claude/

# The parts generator, tools/parts_author
__pycache__/

# Purchased, licensed art. Lives in the PRIVATE Kubik-assets repo and is
# mounted here by scripts/tools/sync_assets.py. Never commit its contents:
# the licences allow use in the game, not redistribution through a public
# repo. The game must always run with this directory absent.
assets/purchased/
