# --- Godot 4 ---
# Derived import/shader/UID cache. Regenerated on open, never commit it.
.godot/

# Android build template, if we ever export to mobile.
/android/

# export_presets.cfg is deliberately NOT ignored. CI has no editor and cannot
# invent an export configuration, so the preset must travel with the repo.
# That is safe only while codesign/enable stays false - signing credentials
# belong in GitHub Actions secrets, never in a committed file.

# Local export output.
build/

# Generated from CSV translation files.
*.translation

# NOTE: *.import files next to assets ARE committed on purpose. They record
# import settings (e.g. nearest-neighbour filtering on our block texture).
# Ignoring them makes assets re-import with defaults on someone else's machine.

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
__pycache__/
