[gd_resource type="Theme" load_steps=19 format=3]

; THE DECO THEME. Paper, ink, gold, alpine blue, sun - the five colours of
; docs/plans/look-v1.md, and nothing else. Set as the project theme in
; project.godot, so every Control in the game inherits it and a screen has to
; opt OUT of the poster rather than into it.
;
; CHAMFERED CORNERS, NOT NOTCHED. The plan asked for a two-step notch. A
; StyleBoxFlat cannot notch, but corner_detail = 1 turns its rounded corner
; into a single straight cut - an octagon - which is the Deco profile without a
; texture, and rule 2 would rather have no texture. Recorded in
; docs/status/look-v1-ui.md.
;
; TYPE. Limelight for the one word that is the title; Josefin Sans, tracked
; and set in capitals, for everything you press; Poiret One for the line under
; a title. All three OFL, licences beside them in assets/fonts.
;
; Colours here are sRGB, as every UI colour in Godot is. The linear-palette
; rule in Block and Races is about VERTEX colours and does not apply to a
; theme.

[ext_resource type="FontFile" path="res://assets/fonts/Limelight-Regular.ttf" id="1_display"]
[ext_resource type="FontFile" path="res://assets/fonts/JosefinSans-Variable.ttf" id="2_body"]
[ext_resource type="FontFile" path="res://assets/fonts/PoiretOne-Regular.ttf" id="3_accent"]

[sub_resource type="FontVariation" id="FontVariation_display"]
base_font = ExtResource("1_display")
spacing_glyph = 8

[sub_resource type="FontVariation" id="FontVariation_body"]
base_font = ExtResource("2_body")
variation_opentype = {
2003265652: 500
}

[sub_resource type="FontVariation" id="FontVariation_caps"]
base_font = ExtResource("2_body")
variation_opentype = {
2003265652: 600
}
spacing_glyph = 3

[sub_resource type="FontVariation" id="FontVariation_section"]
base_font = ExtResource("2_body")
variation_opentype = {
2003265652: 600
}
spacing_glyph = 2

[sub_resource type="FontVariation" id="FontVariation_accent"]
base_font = ExtResource("3_accent")
spacing_glyph = 3

