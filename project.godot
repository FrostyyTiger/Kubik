; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Kubik"
config/description="2-4 player co-op voxel exploration in a cozy-but-eerie fantasy Alps. Built for pairs. Host-authoritative; an authored world with a generative director."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Net="*res://scripts/net/net_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

; UI V1 STAGE 1. THE POSTER SCALES; IT DOES NOT REFLOW.
;
; Until this line every Control in the game was raw 1280x720 pixels, so a
; window of any other size moved the type and left the ornaments where they
; were. `canvas_items` scales the whole logical canvas uniformly, which is what
; a printed poster does when you print it larger - the deliberately absolute
; sizes in Deco (a 9 px rule, a 14 px corner radius, a 44 px button) become
; LOGICAL pixels and keep their proportion to the type they frame.
;
; `expand` rather than `keep`: it gives back the extra as logical canvas rather
; than as black bars, and the scale factor it picks is the SMALLER of the two
; ratios - so the logical canvas is never smaller than 1280x720 in either
; dimension. A wider window gains logical width, a taller one gains logical
; height, and no screen in the game ever has to lay out into less room than it
; was designed for. That is the whole of the audit the design doc asked for.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

; The poster. Every Control in the game inherits it; a screen opts OUT of the
; look rather than into it. See docs/plans/look-v1.md, Stage 7.
theme/custom="res://assets/ui/deco_theme.tres"

[physics]

; JOLT (world feel v1 Stage 9, and P3 - Marcel set it explicitly).
;
; Godot Physics and Jolt disagree in exactly the places this game lives: stacked
; static trimesh colliders in the thousands, one CharacterBody3D stepping over
; half-metre voxel terraces, and - from Stage 11 - rigid bodies that have to go
; to sleep and stay asleep on a slope. Jolt's broadphase and its sleeping are
; both better at that, and the plan pulls physics forward precisely because
; every combat and creature plan is queued behind it.
;
; The tick stays 60. Nothing else belongs in this section: everything that
; behaves differently under Jolt is a property of a body, and bodies are
; configured where they are built.
3d/physics_engine="Jolt Physics"

[shader_globals]

; HOW DARK IT IS, 0 by day and 1 at night, written once per frame by SkyCycle
; and readable by every shader in the game without any of them being handed a
; reference to anything.
;
; A GLOBAL RATHER THAN A UNIFORM PER MATERIAL, deliberately. Night is a fact
; about the world, not about one material: the flora shader wants it for
; glowing mushrooms, the firefly shader for whether fireflies exist at all, and
; anything later - a campfire's light falloff, a torch - will want it too.
; Pushing it to each material as it is added is how a value like this ends up
; set in three places and wrong in one of them.
;
; The transition is a smoothstep across civil twilight, so it is fully night
; well before the sky is black and there is no moment where a mushroom snaps on.
kubik_night={
"type": "float",
"value": 0.0
}

; LIGHT V1 STAGE 0. Where warm light exists: 1 at every hour that has any,
; 0 under eerie weather, which D7 defines as "the same night desaturated,
; thick fog hiding tops, warm lights off". Read by the figure's rune band, the
; glowing mushrooms and the fireflies, so one write turns the life of a scene
; off and nothing has to be handed a reference to the weather.
;
; The eight poster globals that stood here - kubik_shade, kubik_fog_color,
; kubik_fog_start, kubik_fog_end, kubik_fog_bands, kubik_shade_desat,
; kubik_fog_dark and kubik_water - are gone with the ramp and the banded fog
; that read them. The engine lights and fogs the world now; see look.gd.
kubik_warm={
"type": "float",
"value": 1.0
}

[threading]

; Chunk generation and chunk meshing both run as LOW priority worker tasks, and
; Godot gives the low-priority pool only 30% of its threads by default. On a
; 6-core box that is one or two threads for the entire world build, which is
; why threading generation in terrain v2 Stage 3 cut main-thread cost by 90%
; and made WALL time worse: the two phases had started competing for the same
; two threads that meshing alone used to have.
;
; 0.75 leaves a quarter of the pool for whatever else wants it while giving the
; world build most of the machine, which is the right split for a game whose
; startup cost is dominated by exactly this work.
worker_pool/low_priority_thread_ratio=0.75
