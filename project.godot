; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Kubik"
config/description="2-4 player co-op voxel exploration in a cozy-but-eerie fantasy Alps. Built for pairs. Host-authoritative; an authored world with a generative director."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Net="*res://scripts/net/net_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[gui]

; The poster. Every Control in the game inherits it; a screen opts OUT of the
; look rather than into it. See docs/plans/look-v1.md, Stage 7.
theme/custom="res://assets/ui/deco_theme.tres"

[shader_globals]

; HOW DARK IT IS, 0 by day and 1 at night, written once per frame by SkyCycle
; and readable by every shader in the game without any of them being handed a
; reference to anything.
;
; A GLOBAL RATHER THAN A UNIFORM PER MATERIAL, deliberately. Night is a fact
; about the world, not about one material: the flora shader wants it for
; glowing mushrooms, the firefly shader for whether fireflies exist at all, and
; anything later - a campfire's light falloff, a torch - will want it too.
; Pushing it to each material as it is added is how a value like this ends up
; set in three places and wrong in one of them.
;
; The transition is a smoothstep across civil twilight, so it is fully night
; well before the sky is black and there is no moment where a mushroom snaps on.
kubik_night={
"type": "float",
"value": 0.0
}

; THE POSTER, look v1. The colour of shade, the colour of distance, and where
; distance begins, ends and how many flat steps it takes - written every frame
; by SkyCycle.apply() through Look.publish(). The defaults are a clear day, so
; a scene with no SkyCycle (a self-test, a stray tool) draws sensibly.
;
; vec4 AND LINEAR, NOT color. The Compatibility renderer ignores colour-space
; hints, and every palette in the game is stored linear for that reason - so
; these are too, and SkyCycle converts before it publishes.
kubik_shade={
"type": "vec4",
"value": Vector4(0.25, 0.29, 0.55, 1.0)
}
kubik_fog_color={
"type": "vec4",
"value": Vector4(0.46, 0.60, 0.77, 1.0)
}
kubik_fog_start={
"type": "float",
"value": 360.0
}
kubik_fog_end={
"type": "float",
"value": 600.0
}
kubik_fog_bands={
"type": "float",
"value": 6.0
}

; LOOK V2. How far the shade side is desaturated toward its own luminance
; before the ink colours it (rule 1, sharpened): the shade band keeps the
; surface's LUMINANCE and takes the ink's HUE, which a multiply cannot do.
; Per keyframe - 0.55 by day, 0.75 at night - so the night is greyer.
kubik_shade_desat={
"type": "float",
"value": 0.55
}

; The fog colour one band darker. Figures fog toward this and terrain toward
; kubik_fog_color, so a character at distance stays a step darker than the
; ground behind it instead of dissolving into it.
kubik_fog_dark={
"type": "vec4",
"value": Vector4(0.30, 0.34, 0.42, 1.0)
}

; The water's colour for the hour, published so lakes.gd does not have to own a
; time-of-day table of its own. Used from Stage 4.
kubik_water={
"type": "vec4",
"value": Vector4(0.07, 0.15, 0.26, 1.0)
}

[threading]

; Chunk generation and chunk meshing both run as LOW priority worker tasks, and
; Godot gives the low-priority pool only 30% of its threads by default. On a
; 6-core box that is one or two threads for the entire world build, which is
; why threading generation in terrain v2 Stage 3 cut main-thread cost by 90%
; and made WALL time worse: the two phases had started competing for the same
; two threads that meshing alone used to have.
;
; 0.75 leaves a quarter of the pool for whatever else wants it while giving the
; world build most of the machine, which is the right split for a game whose
; startup cost is dominated by exactly this work.
worker_pool/low_priority_thread_ratio=0.75
